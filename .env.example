# Settings for `npm run demo` and `npm run devices`. Copy this file to .env and fill in what you need;
# .env is not committed. Every line is optional: with none set, the demo runs with its defaults.

# The storage bucket (any S3-compatible service; the server uses path-style addresses). Request results and
# uploaded prompt files are stored in it. Without S3_ENDPOINT they are kept in memory and are lost when the
# server stops. The bucket must exist already.
# S3_ENDPOINT=https://<your-storage-endpoint>
# S3_REGION=us-east-1
# S3_BUCKET=<your-bucket-name>
# S3_ACCESS_KEY_ID=<your-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-secret-access-key>

# A PostgreSQL of your own, instead of the one the demo keeps under ./data.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# The port of the website (the address is then https://localhost:<port>). Both commands read it.
# PORT=8443

# Whether new accounts can be created: open (the default) or closed.
# OPENINFER_REGISTRATION=open
