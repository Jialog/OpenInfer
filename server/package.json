{
  "name": "@openinfer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The OpenInfer server: REST API, WebSockets, PostgreSQL and object storage",
  "scripts": {
    "test:schema": "node --test test/schema.test.mjs",
    "build": "tsc",
    "start": "node dist/main.js",
    "migrate": "node dist/main.js --migrate-only",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts && node --test test/schema.test.mjs",
    "test:state": "tsx --test test/state.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "argon2": "0.45.2",
    "embedded-postgres": "18.6.0-beta.19",
    "express": "5.3.0",
    "ws": "8.22.2",
    "zod": "4.6.7",
    "pg": "8.23.1"
  }
}
